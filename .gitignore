# Local secrets, environments, and caches
.env
.env.*
!.env.example
*.pem
__pycache__/
.venv/
.cache/
tmp/
.claude/settings.local.json

# The owner's reference books stay on the owner's machines only.
/references/

# PDFs and ZIPs are never committed (AGENTS.md, docs/LARGE_FILES.md): deliveries go to GitHub Releases,
# and art packages are built on request.
*.pdf
*.zip

# Generated build intermediates (reproducible via `make`)
build/
typst/content.typ
typst/measure.typ
figures/anchor_proposals.json
dist/SHA256SUMS.txt
assets/hero-record/previews/

# Player-aid renders belong in build/aids/, never beside the sources
typst/aids/*.png

# CLAUDE.md optimizer backups
.claude-md-backup/
