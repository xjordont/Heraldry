# Build caches and local secrets; retain production state and final deliverables.
.env
.env.*
!.env.example
*.pem
__pycache__/
.venv/
node_modules/
.cache/
tmp/
build/page-renders/
production/private/

# Optional commercial reference evidence is local by default.
references/private/

# Generated build intermediates (reproducible via `make`)
build/
typst/content.typ
figures/src/test/
figures/anchor_proposals.json
typst/measure.typ
dist/*.zip
dist/SHA256SUMS.txt

# Large build outputs are never committed (docs/LARGE_FILES.md): PDFs go to a GitHub Release,
# art packages are built on request.
dist/**/*.pdf
*.idml
*.indd
*.indb
*.indt
production/art/skill/*.zip
production/art/work/*.zip
